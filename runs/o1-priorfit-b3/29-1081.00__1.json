   "design": "Tests are requested electronically and results arrive in the record by integration, instead of requesting by mail and retyping reports. With consent, a certified scribe drafts the note, and the podiatrist corrects every note before it is saved. History taking, examination, reviewing images and results, and discussion stay with the podiatrist.",
   "approvals": [],
   "previous_blocker": "Results were retyped and notes typed after each visit.",
   "enabler_now": "Electronic test requests, result integration and certified scribes.",
   "still_hard": "Results from labs without an electronic link.",
   "human_edge": "Feeling a deformity a scan does not show.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less typing; diagnosis stays.",
   "reach": [
    {
     "role": "GP",
     "task": "Refer patients",
     "learn": "Whether findings come back sooner."
    }
   ],
