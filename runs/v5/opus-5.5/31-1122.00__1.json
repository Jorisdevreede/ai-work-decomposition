    }
   ],
   "design": "The aide writes notes in the care app at the client's home, so they are not retyped at the end of the shift. Hours come from the aide's check-in and check-out in the app at each visit, with the planned services; the aide corrects them, checks the period's timesheet and submits it once. The notes themselves, calls to the supervisor, handover, reading notes and family talks stay with the aide. Saving notes is an ordinary save and needs no approval.",
   "previous_blocker": "Notes were written on paper and retyped; hours were written by hand.",
   "enabler_now": "Care apps on a phone with the visit schedule.",
   "still_hard": "Homes without signal.",
   "human_edge": "Noticing that a client is not themselves today.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less retyping; observing and reporting stay.",
   "reach": [
    {
     "role": "supervisors and colleagues",
     "task": "Follow clients",
     "learn": "Whether notes are current."
    }
   ],
