   "enabler_now": "Analysis scripts and codebook coding with double-coded samples.",
   "still_hard": "New issues the codebook does not cover.",
   "human_edge": "Seeing what a shift in opinion means.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less data handling; interpretation stays.",
