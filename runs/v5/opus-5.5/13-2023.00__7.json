    {
     "id": "a1",
     "action_step_id": "s8",
     "approved_version": "The bill run with parcels, values, rates and totals exactly as checked by the assessor in s7, released once for printing; any change needs a new check.",
     "approval_step_id": "s7",
     "approver": "assessor"
    }
   ],
   "design": "The tax system reads assessed values from the assessment register and multiplies them by the rate table, applying exemptions by rule, instead of copying and calculating in a spreadsheet. It flags bills that changed sharply from last year and produces the run totals for finance. Reading and entering rates, reviewing flags, owner corrections, the check, the release and colleagues' questions stay with the assessor. The assessor releases each run, so no bill is a solely automated decision.",
   "previous_blocker": "Values were copied and bills calculated in spreadsheets.",
   "enabler_now": "A tax system linked to the assessment register, with rate and exemption rules.",
   "still_hard": "Exemptions that need a decision per owner.",
   "human_edge": "Spotting a bill that is technically right but wrong for the owner.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Copying and arithmetic disappear; checking stays.",
   "reach": [
    {
     "role": "finance",
     "task": "Book tax revenue",
     "learn": "Whether totals arrive sooner."
    }
   ],
   "build_days": {
    "coding": "1-2",
    "integration": "1-2",
    "testing_rollout": "1-2",
    "consent_and_access": "0"
   },
