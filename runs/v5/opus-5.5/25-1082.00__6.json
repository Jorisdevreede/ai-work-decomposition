   "approvals": [],
   "design": "An answer desk on the published admission pages answers prospective students' questions with a quote from the page, marked as AI, so fewer simple questions reach the teacher; questions about a person's own diploma or admission still come to the teacher. Students submit placement details on an online form that writes the placement register, instead of the teacher typing them from mails. Open days, trial lectures, diploma checks, calls to hosts and the admissions committee stay with the teacher; no system takes part in admission decisions.",
   "previous_blocker": "Every question came by mail and placements were typed from mails.",
   "enabler_now": "An answer desk on published pages and an online placement form.",
   "still_hard": "Applicants with foreign diplomas.",
   "human_edge": "Convincing a doubtful student the field suits them.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Fewer repeat questions; recruitment talks stay.",
   "reach": [
    {
     "role": "prospective students",
     "task": "Choose a programme",
     "learn": "Whether answers come faster."
    }
   ],
