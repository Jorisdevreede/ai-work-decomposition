   "design": "Manual readings are entered on the bench terminal straight into the laboratory system instead of from the worksheet later. Stand-alone instruments are interfaced to the system, and external labs send results electronically instead of on paper, so they are not typed. With fewer typed values there is less double-checking, fewer corrections and less paper to file. Comments stay with the technologist. Saving entries is an ordinary save and needs no approval.",
   "previous_blocker": "Results were typed from worksheets, printouts and paper reports.",
   "enabler_now": "Instrument interfaces, bench entry and electronic result messages.",
   "still_hard": "Old instruments with no interface.",
   "human_edge": "Noticing a value that cannot be right.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Most typing disappears; checking what remains stays.",
   "reach": [
    {
     "role": "external laboratories",
     "task": "Send results",
     "learn": "Whether electronic messages arrive complete."
    }
   ],
