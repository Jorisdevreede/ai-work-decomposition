   "design": "Freezer and tunnel controllers log their temperatures to the production system every few minutes, and connected scales and line counters log amounts processed, so the operator no longer reads those displays for the form or writes the values down. The shift log totals itself from the logged values. Probing core temperatures, weighing on unconnected scales, product tests, writing those results, signing and telling the shift leader stay with the operator. The logs record the equipment, not the operator.",
   "approvals": [],
   "previous_blocker": "Every value was read and written by hand.",
   "enabler_now": "Controllers and scales that log to the production system.",
   "still_hard": "Older freezers without a data connection.",
   "human_edge": "Noticing product that feels wrong at a normal reading.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less reading and writing; probing and testing stay.",
   "reach": [
    {
     "role": "quality staff",
     "task": "Keep food safety records",
     "learn": "Whether records have fewer gaps."
    }
   ],
