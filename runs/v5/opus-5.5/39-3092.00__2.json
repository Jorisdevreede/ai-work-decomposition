   "design": "Each costume carries a barcode tag. Scanning it at issue and at return, with a status pick at return, writes the item's holder and status to a records app, so sign-out sheets and tag notes are not retyped into a spreadsheet, and the last holder of a missing item shows on the item's record. Pulling, handing out, collecting, checking condition, tag notes for the laundry and asking about missing items stay with the attendant.",
   "approvals": [],
   "previous_blocker": "Sheets were retyped into a spreadsheet and searched by hand.",
   "enabler_now": "Barcode tags and a records app.",
   "still_hard": "Quick changes where nobody scans.",
   "human_edge": "Knowing which dresser left a costume where.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less retyping; handling stays.",
   "reach": [
    {
     "role": "dressers",
     "task": "Dress cast",
     "learn": "Whether missing items are found sooner."
    }
   ],
