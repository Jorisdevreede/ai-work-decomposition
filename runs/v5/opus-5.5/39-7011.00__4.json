   "design": "A phone menu sends common calls (bookings, groups, lost property) to the right person, so the guide routes fewer calls by hand. Mail with a booking reference goes to that booking's owner by rule, and customers change bookings on an online form that updates the booking system after a rule check. Filing, typing letters and sorting post stay with the guide.",
   "previous_blocker": "Every call and mail was routed by hand, and changes retyped.",
   "enabler_now": "Phone menus, mail rules and online change forms.",
   "still_hard": "Callers who do not fit the menu.",
   "human_edge": "Knowing who in the office can help.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less routing and retyping; filing and letters stay.",
   "reach": [
    {
     "role": "customers",
     "task": "Change bookings",
     "learn": "Whether the online form is used."
    }
   ],
