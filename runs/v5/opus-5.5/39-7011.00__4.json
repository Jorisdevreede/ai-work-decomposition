   "approvals": [],
   "design": "The guide scans each booked visitor's QR ticket with a phone app linked to the booking system, instead of ticking a paper list. Walk-up visitors pay online by QR code, so there is less cash to collect, count and hand over. Scans and payments update the booking, so nothing is typed after the tour, and no-shows show up in the office's view instead of by phone. Disputes stay with the guide. The app records tickets, not guides' locations.",
   "previous_blocker": "Paper lists, cash and retyping after each tour.",
   "enabler_now": "Ticket scanning and online payment linked to the booking system.",
   "still_hard": "Visitors without a phone or a card.",
   "human_edge": "Settling a ticket mix-up without spoiling the tour.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less cash and paper; the welcome stays.",
   "reach": [
    {
     "role": "office staff",
     "task": "Reconcile tours",
     "learn": "Whether figures arrive the same day."
    }
   ],
