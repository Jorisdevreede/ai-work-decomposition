     "claim": "Hospital records can pass room-level isolation status to cleaning task apps.",
     "grade": "E1",
     "source": "model knowledge",
     "kind": "capability"
    },
    {
     "claim": "Isolation status reveals health data; share only room and isolation type.",
     "grade": "E1",
     "source": "model knowledge",
     "kind": "legal"
    }
   ],
   "assumptions": [
    "Boundary: from the isolation notice to reported problems; infection policy is outside.",
    "Input contract: isolation status set by ward nurses in the record; protocols set by the infection prevention team; fallback is phone and paper.",
    "Assigning, instructing and checking do not change.",
    "Records are about rooms, not used to rate cleaners."
   ],
