   "design": "After each activity the worker enters a level per treatment goal and a short note on a tablet in the care record system ({OTHER}), so nothing is copied at the end of the week. The system builds a progress summary per participant from those entries for the care plan review; observing and discussing progress with the team stay as they are.",
   "previous_blocker": "Notes were written on paper and copied into the care record weekly.",
   "enabler_now": "Care record systems hold goal-based entries on tablets and summarise them.",
   "still_hard": "Levels per goal are judgement; notes are health data with strict access.",
   "human_edge": "Seeing a withdrawn resident join in for the first time and knowing what it means.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Nothing changes.",
   "reach": [
    {
     "role": "activity therapist",
     "task": "Report to the care team",
     "learn": "Whether goal entries make reviews shorter."
    }
   ],
