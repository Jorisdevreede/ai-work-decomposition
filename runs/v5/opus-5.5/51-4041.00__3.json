   "design": "A scale under each waste container logs the weight per metal and waste stream to the waste record in the {ERP}; the machinist only scans the bin label when emptying a bin into it. When a container passes its fill weight, the system sends a pickup request to the logistics coordinator. Sorting, separating hazardous waste and checking bins stay manual.",
   "previous_blocker": "Weights were written on a sheet and full bins reported by word of mouth.",
   "enabler_now": "Container scales log weights per stream and send fill alerts.",
   "still_hard": "Mixed scrap loses value; sorting depends on care at the machine.",
   "human_edge": "Telling brass from bronze chips by look and feel.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Nothing changes.",
   "reach": [
    {
     "role": "logistics coordinator",
     "task": "Plan waste pickups",
     "learn": "Whether weight alerts cut emergency pickups."
    }
   ],
