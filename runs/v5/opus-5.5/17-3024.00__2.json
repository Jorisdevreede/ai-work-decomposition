   "approvals": [
    {
     "id": "a1",
     "action_step_id": "s12",
     "approved_version": "The purchase request exactly as checked by the technician in s11, with item numbers, suppliers and quantities, sent once to purchasing; any change needs a new check.",
     "approval_step_id": "s11",
     "approver": "mechatronics technician"
    }
   ],
   "design": "The inventory moves from a spreadsheet to a records app. Counts are recorded by barcode scan in the store, and mechanics scan parts they take at the store terminal, so the technician no longer types count sheets and issue slips into the spreadsheet. Test reports carry the equipment number and test type in their file data, so the document system files them; manuals and drawings without that data are still filed by hand. The app lists parts below their minimum and fills item number and supplier in the purchase request from the item record; the technician sets the quantity, checks it and sends it. Counting, setting up the system, floor checks, questions and meetings stay with the technician.",
   "previous_blocker": "Counts and slips were typed into a spreadsheet and low stock found by reading it.",
   "enabler_now": "Barcode records apps and document systems that file by metadata.",
   "still_hard": "Parts taken without scanning.",
   "human_edge": "Knowing which spare will be needed before it runs out.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "Less retyping; the system design stays.",
   "reach": [
