   "design": "Literature screening uses active learning with a stop rule fixed beforehand. Interview transcripts are coded against a fixed codebook with suggested codes; the psychologist double-codes a sample and coding is released only above the agreed agreement rate. The analysis set in the study plan runs as a versioned script. Planning, data collection and writing stay with the psychologist; no model writes the paper.",
   "previous_blocker": "Records were screened and transcripts coded one by one.",
   "enabler_now": "Active learning screening and code suggestions in qualitative analysis tools.",
   "still_hard": "Codebooks drift as understanding grows.",
   "human_edge": "Seeing the theme the codebook did not anticipate.",
   "ambition": {
    "kind": "none",
    "what": ""
   },
   "altitude": "The psychologist checks samples instead of coding everything.",
   "reach": [
    {
     "role": "research assistant",
     "task": "Code data",
     "learn": "Whether coding is consistent."
    }
   ],
   "build_days": {
    "coding": "0-1",
    "integration": "0",
    "testing_rollout": "0-1",
    "consent_and_access": "0-1"
   },
   "run_cost": "low",
   "evidence": [
    {
     "claim": "MAXQDA suggests codes and advises a human check of every AI-coded segment.",
     "grade": "E2",
     "source": "[S3]",
     "kind": "capability"
    },
    {
     "claim": "On British Election Study answers, the best LLM coded 93.9% accurately against 94.7% for a second human coder.",
