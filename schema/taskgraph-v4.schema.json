{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_code",
    "tasks",
    "role"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uid",
          "short",
          "steps",
          "design",
          "previous_blocker",
          "enabler_now",
          "still_hard",
          "human_edge",
          "ambition",
          "altitude",
          "reach",
          "build_days",
          "run_cost",
          "evidence",
          "assumptions",
          "unknowns",
          "research_questions",
          "new_work",
          "approvals",
          "time_saved_range_pct"
        ],
        "properties": {
          "uid": {
            "type": "string"
          },
          "short": {
            "type": "string",
            "description": "The task today in at most 20 plain words"
          },
          "steps": {
            "type": "array",
            "description": "The steps of the task as typically done today, in order. A new step starts only when the actor, the system or means, the artefact produced, or a decision or approval point changes; as many steps as that gives (one is fine, so are twelve). share_pct adds up to 100.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "what",
                "actor",
                "today_means",
                "systems",
                "inputs",
                "outputs",
                "handoff_to",
                "share_pct",
                "fate",
                "remaining_pct",
                "block",
                "rung",
                "loop",
                "authority",
                "human_gate",
                "boundary",
                "workflow",
                "approver",
                "labour_scope",
                "shared_step_id",
                "approval_refs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "s1, s2, ..."
                },
                "what": {
                  "type": "string",
                  "description": "The step in at most 15 words"
                },
                "actor": {
                  "type": "string",
                  "description": "Who does it today: a generic role name (e.g. 'recruiter', 'hiring manager', 'finance team', 'candidate'), 'system' or 'external'"
                },
                "today_means": {
                  "type": "string",
                  "enum": [
                    "system_screen",
                    "spreadsheet",
                    "email_chat",
                    "document",
                    "meeting_call",
                    "paper_phone",
                    "in_person"
                  ]
                },
                "systems": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "HCM",
                      "PAYROLL",
                      "ATS",
                      "LMS",
                      "TALENT",
                      "ERP",
                      "EXPENSE",
                      "PROCUREMENT",
                      "BANK",
                      "CRM",
                      "MARKETING_AUTOMATION",
                      "CMS",
                      "ADS",
                      "SOCIAL",
                      "ECOMMERCE",
                      "HELPDESK",
                      "TELEPHONY",
                      "EMAIL",
                      "CHAT",
                      "CALENDAR",
                      "DOCS",
                      "SPREADSHEET",
                      "BI",
                      "PROJECT",
                      "ESIGN",
                      "CLM",
                      "OPS_SYSTEM",
                      "DATA_PLATFORM",
                      "WORKFLOW",
                      "PARTNER_PORTAL",
                      "GOV_PORTAL",
                      "OTHER"
                    ]
                  },
                  "description": "System slot ids only (see the slot list); never product names"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Artefacts it needs: short nouns, reused across tasks, e.g. 'timesheet export', 'agency invoice'"
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Artefacts it produces, same naming"
                },
                "handoff_to": {
                  "type": "string",
                  "description": "Generic role name, 'external' or 'none'"
                },
                "share_pct": {
                  "type": "integer",
                  "description": "Share of the task's time today; the steps add up to 100",
                  "minimum": 1,
                  "maximum": 100
                },
                "fate": {
                  "type": "string",
                  "enum": [
                    "gone",
                    "machine",
                    "person_reviews",
                    "person_does"
                  ]
                },
                "remaining_pct": {
                  "type": "integer",
                  "description": "The person's remaining time on this step as a percentage of today's: gone and machine 0, person_reviews the review time, person_does up to 100",
                  "minimum": 0,
                  "maximum": 100
                },
                "block": {
                  "type": "string",
                  "enum": [
                    "none",
                    "artefact_generator",
                    "workflow_automation",
                    "crud_app",
                    "dashboard",
                    "answer_desk",
                    "integration",
                    "judgement_step",
                    "conversation",
                    "notification"
                  ]
                },
                "rung": {
                  "type": "string",
                  "enum": [
                    "eliminate",
                    "configure",
                    "deterministic",
                    "deterministic_plus_loop",
                    "agent",
                    "stays_manual"
                  ],
                  "description": "Cheapest build that handles this step: eliminate the step, configure existing software, deterministic code, deterministic code with a bounded model loop, an autonomous agent (only with a reason in loop.why_not_simpler), or stays manual"
                },
                "loop": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "purpose",
                    "input",
                    "output",
                    "check",
                    "stop",
                    "why_not_simpler"
                  ],
                  "description": "Only for deterministic_plus_loop and agent; null otherwise",
                  "properties": {
                    "purpose": {
                      "type": "string",
                      "description": "read, extract, classify, judge, reconcile, draft, ask"
                    },
                    "input": {
                      "type": "string"
                    },
                    "output": {
                      "type": "string"
                    },
                    "check": {
                      "type": "string",
                      "description": "How the output is validated before use"
                    },
                    "stop": {
                      "type": "string",
                      "description": "Stop condition, budget and fallback"
                    },
                    "why_not_simpler": {
                      "type": "string"
                    }
                  }
                },
                "authority": {
                  "type": "string",
                  "enum": [
                    "read",
                    "draft",
                    "write_internal",
                    "act_external"
                  ]
                },
                "human_gate": {
                  "type": "boolean",
                  "description": "A person approves the result of this step before it takes effect"
                },
                "boundary": {
                  "type": "string",
                  "enum": [
                    "start",
                    "actor",
                    "system_or_means",
                    "artefact",
                    "decision"
                  ],
                  "description": "Why this step starts here"
                },
                "workflow": {
                  "type": "string",
                  "description": "The value stream this step belongs to, from the workflow list (kebab-case id), so steps of different tasks and jobs connect"
                },
                "approver": {
                  "type": "string",
                  "description": "Generic role that approves when human_gate is true, else 'none'"
                },
                "labour_scope": {
                  "type": "string",
                  "enum": [
                    "focal_role",
                    "other_role",
                    "supplier",
                    "customer",
                    "system"
                  ],
                  "description": "Whose time TODAY this share represents. Only focal_role enters role savings; system has no human baseline."
                },
                "shared_step_id": {
                  "type": "string",
                  "description": "Stable workflow/artefact/action id for cross-task deduplication, or empty when not shared. Never sum shared steps across roles without ownership resolution."
                },
                "approval_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Id in this task approvals list. Each reference must cover THIS action step."
                  }
                }
              }
            }
          },
          "design": {
            "type": "string",
            "description": "The target solution in two or three sentences, stitched from building blocks, with systems written as {SLOT} placeholders (e.g. 'a scheduled job on the {DATA_PLATFORM} matches {PARTNER_PORTAL} hours to invoices in {ERP}, notifies the team lead and feeds a {BI} dashboard'). Never name products here."
          },
          "previous_blocker": {
            "type": "string",
            "description": "Why this was not automated before"
          },
          "enabler_now": {
            "type": "string",
            "description": "What makes it feasible now"
          },
          "still_hard": {
            "type": "string",
            "description": "What stays hard or expensive"
          },
          "human_edge": {
            "type": "string"
          },
          "ambition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "what"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "decide_more_often",
                  "serve_new_group",
                  "new_service",
                  "none"
                ]
              },
              "what": {
                "type": "string",
                "description": "One specific thing, named; empty when kind is none"
              }
            }
          },
          "altitude": {
            "type": "string",
            "description": "The person's week after the change and the decision rights they gain, in one or two sentences; say if nothing changes"
          },
          "reach": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "task",
                "learn"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                },
                "learn": {
                  "type": "string"
                }
              }
            }
          },
          "build_days": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coding",
              "integration",
              "testing_rollout",
              "consent_and_access"
            ],
            "description": "Ranges in working days, e.g. '2-4'",
            "properties": {
              "coding": {
                "type": "string"
              },
              "integration": {
                "type": "string"
              },
              "testing_rollout": {
                "type": "string"
              },
              "consent_and_access": {
                "type": "string"
              }
            }
          },
          "run_cost": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim",
                "grade",
                "source",
                "kind"
              ],
              "properties": {
                "claim": {
                  "type": "string"
                },
                "grade": {
                  "type": "string",
                  "enum": [
                    "E0",
                    "E1",
                    "E2",
                    "E3"
                  ]
                },
                "source": {
                  "type": "string",
                  "description": "Exactly 'model knowledge' for E0/E1 without a source, or one or more digest ids '[S3], [S4]'. No URLs or unqualified source numbers. E2/E3 require digest ids; only capability/case may use E2/E3."
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "capability",
                    "case",
                    "legal",
                    "benchmark",
                    "survey"
                  ]
                }
              }
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Facts only the customer can confirm"
          },
          "research_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "new_work": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "already_counted",
              "incremental"
            ],
            "properties": {
              "already_counted": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "description",
                    "labour_scope",
                    "hours_per_100_baseline_hours",
                    "counted_step_ids"
                  ],
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": ""
                    },
                    "labour_scope": {
                      "type": "string",
                      "enum": [
                        "focal_role",
                        "other_role",
                        "supplier",
                        "customer",
                        "system"
                      ]
                    },
                    "hours_per_100_baseline_hours": {
                      "type": "number",
                      "minimum": 0
                    },
                    "counted_step_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": ""
                      },
                      "minItems": 1
                    }
                  },
                  "description": "Already included in positive remaining step time. Informational, never subtract again."
                }
              },
              "incremental": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "description",
                    "labour_scope",
                    "hours_per_100_baseline_hours"
                  ],
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": ""
                    },
                    "labour_scope": {
                      "type": "string",
                      "enum": [
                        "focal_role",
                        "other_role",
                        "supplier",
                        "customer",
                        "system"
                      ]
                    },
                    "hours_per_100_baseline_hours": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "description": "Extra steady-state hours per 100 focal-role baseline hours for THIS task, not already in steps; subtract focal_role hours once. Estimate ongoing upkeep and exceptions, not one-time build effort."
                },
                "minItems": 1
              }
            },
            "description": "Separate review already priced in steps from additional workload. All hours use 100 focal-role baseline hours for this task, not annual company hours. Include a numeric allowance for upkeep, or explicitly justify zero in assumptions."
          },
          "approvals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "action_step_id",
                "approved_version",
                "approval_step_id",
                "approver"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": ""
                },
                "action_step_id": {
                  "type": "string",
                  "description": "The exact step whose action is approved."
                },
                "approved_version": {
                  "type": "string",
                  "description": "The artefact version / input snapshot bound to approval; reject stale approvals after changes."
                },
                "approval_step_id": {
                  "type": "string",
                  "description": "Step in THIS task carrying positive remaining human time; may be the action itself only when human time remains."
                },
                "approver": {
                  "type": "string",
                  "description": "Generic human role; match action approver and time-counted step actor."
                }
              },
              "description": ""
            }
          },
          "time_saved_range_pct": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "low",
              "high",
              "basis"
            ],
            "properties": {
              "low": {
                "type": "number",
                "maximum": 100
              },
              "high": {
                "type": "number",
                "maximum": 100
              },
              "basis": {
                "type": "string",
                "description": "Conservative scenario assumptions after incremental focal-role work; low <= high <= central net saving. Provisional, not measured."
              }
            },
            "description": ""
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "altitude",
        "reach",
        "skills_to_grow",
        "ambitious_version"
      ],
      "properties": {
        "altitude": {
          "type": "string"
        },
        "reach": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills_to_grow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambitious_version": {
          "type": "string"
        }
      }
    },
    "job_code": {
      "type": "string"
    }
  },
  "title": "Generic task graph v4 — scoped labour and action-bound approvals"
}
