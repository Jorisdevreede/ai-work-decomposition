{
  "type": "object",
  "additionalProperties": false,
  "required": ["role_id", "tasks", "role"],
  "properties": {
    "role_id": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uid", "short", "steps", "design", "previous_blocker", "enabler_now", "still_hard",
                     "human_edge", "ambition", "altitude", "reach", "build_days", "run_cost",
                     "evidence", "assumptions", "unknowns", "research_questions"],
        "properties": {
          "uid": {"type": "string"},
          "short": {"type": "string", "description": "The task today in at most 20 plain words"},
          "steps": {
            "type": "array",
            "description": "Three to seven steps of the task as it is done today, in order, with their share of the task's time and what each becomes",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "what", "actor", "today_means", "systems", "inputs", "outputs", "handoff_to",
                           "share_pct", "fate", "remaining_pct", "block", "rung", "loop", "authority", "human_gate"],
              "properties": {
                "id": {"type": "string", "description": "s1, s2, ..."},
                "what": {"type": "string", "description": "The step in at most 15 words"},
                "actor": {"type": "string", "description": "Role id of who does it today, or 'external' or 'system'"},
                "today_means": {"type": "string", "enum": ["system_screen", "spreadsheet", "email_chat", "document", "meeting_call", "paper_phone", "in_person"]},
                "systems": {"type": "array", "items": {"type": "string"}},
                "inputs": {"type": "array", "items": {"type": "string"}, "description": "Artefacts it needs: short nouns, reused across tasks, e.g. 'timesheet export', 'agency invoice'"},
                "outputs": {"type": "array", "items": {"type": "string"}, "description": "Artefacts it produces, same naming"},
                "handoff_to": {"type": "string", "description": "Role id, team, 'external' or 'none': who takes the output next"},
                "share_pct": {"type": "integer", "description": "Share of the task's time today; the steps add up to 100"},
                "fate": {"type": "string", "enum": ["gone", "machine", "person_reviews", "person_does"]},
                "remaining_pct": {"type": "integer", "description": "The person's remaining time on this step as a percentage of today's: gone and machine 0, person_reviews the review time, person_does up to 100"},
                "block": {"type": "string", "enum": ["none", "artefact_generator", "workflow_automation", "crud_app", "dashboard", "answer_desk", "integration", "judgement_step", "conversation", "notification"]},
                "rung": {"type": "string", "enum": ["eliminate", "configure", "deterministic", "deterministic_plus_loop", "agent", "stays_manual"], "description": "Cheapest build that handles this step: eliminate the step, configure existing software, deterministic code, deterministic code with a bounded model loop, an autonomous agent (only with a reason in loop.why_not_simpler), or stays manual"},
                "loop": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["purpose", "input", "output", "check", "stop", "why_not_simpler"],
                  "description": "Only for deterministic_plus_loop and agent; null otherwise",
                  "properties": {
                    "purpose": {"type": "string", "description": "read, extract, classify, judge, reconcile, draft, ask"},
                    "input": {"type": "string"}, "output": {"type": "string"},
                    "check": {"type": "string", "description": "How the output is validated before use"},
                    "stop": {"type": "string", "description": "Stop condition, budget and fallback"},
                    "why_not_simpler": {"type": "string"}
                  }
                },
                "authority": {"type": "string", "enum": ["read", "draft", "write_internal", "act_external"]},
                "human_gate": {"type": "boolean", "description": "A person approves the result of this step before it takes effect"}
              }
            }
          },
          "design": {"type": "string", "description": "The target solution in two or three sentences: which building blocks, stitched how, on what kind of platform. E.g. 'Replace the Excel sheet that ties AFAS and the agency portals with a scheduled Python job on the governed data platform; it matches hours to invoices, notifies the team lead of breaks and feeds a dashboard.'"},
          "previous_blocker": {"type": "string", "description": "Why this was not automated before"},
          "enabler_now": {"type": "string", "description": "What makes it feasible now"},
          "still_hard": {"type": "string", "description": "What stays hard or expensive"},
          "human_edge": {"type": "string"},
          "ambition": {
            "type": "object", "additionalProperties": false, "required": ["kind", "what"],
            "properties": {
              "kind": {"type": "string", "enum": ["decide_more_often", "serve_new_group", "new_service", "none"]},
              "what": {"type": "string", "description": "One specific thing, named; empty when kind is none"}
            }
          },
          "altitude": {"type": "string", "description": "The person's week after the change and the decision rights they gain, in one or two sentences; say if nothing changes"},
          "reach": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": false, "required": ["role", "task", "learn"],
                      "properties": {"role": {"type": "string"}, "task": {"type": "string"}, "learn": {"type": "string"}}}
          },
          "build_days": {
            "type": "object", "additionalProperties": false,
            "required": ["coding", "integration", "testing_rollout", "consent_and_access"],
            "description": "Ranges in working days, e.g. '2-4'",
            "properties": {
              "coding": {"type": "string"}, "integration": {"type": "string"},
              "testing_rollout": {"type": "string"}, "consent_and_access": {"type": "string"}
            }
          },
          "run_cost": {"type": "string", "enum": ["none", "low", "medium", "high"]},
          "evidence": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": false, "required": ["claim", "grade", "source"],
                      "properties": {
                        "claim": {"type": "string"},
                        "grade": {"type": "string", "enum": ["E0", "E1", "E2", "E3"]},
                        "source": {"type": "string", "description": "A source id from the digest such as [S3], or 'model knowledge'"}
                      }}
          },
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "unknowns": {"type": "array", "items": {"type": "string"}, "description": "Facts only the customer can confirm"},
          "research_questions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["altitude", "reach", "skills_to_grow", "ambitious_version"],
      "properties": {
        "altitude": {"type": "string"},
        "reach": {"type": "array", "items": {"type": "string"}},
        "skills_to_grow": {"type": "array", "items": {"type": "string"}},
        "ambitious_version": {"type": "string"}
      }
    }
  }
}
