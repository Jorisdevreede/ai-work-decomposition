{
  "type": "object",
  "additionalProperties": false,
  "required": ["role_id", "tasks", "role"],
  "properties": {
    "role_id": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uid", "short", "today", "anatomy", "lenses", "human_edge", "pattern", "pattern_why",
                     "autonomy_level", "in_practice", "time_saved_pct", "speedup", "confidence", "evidence",
                     "risks", "research_questions"],
        "properties": {
          "uid": {"type": "string"},
          "short": {"type": "string", "description": "The task today in at most 20 plain words, as the person would say it at this company"},
          "today": {
            "type": "object", "additionalProperties": false,
            "required": ["trigger", "steps", "systems", "drudgery", "time_sinks"],
            "properties": {
              "trigger": {"type": "string"},
              "steps": {"type": "array", "items": {"type": "string"}},
              "systems": {"type": "array", "items": {"type": "string"}},
              "drudgery": {"type": "array", "items": {"type": "string"}},
              "time_sinks": {"type": "string"}
            }
          },
          "anatomy": {
            "type": "object", "additionalProperties": false,
            "description": "Percent of the time per kind of work; the six add up to 100",
            "required": ["gather", "transform", "decide", "create", "communicate", "coordinate"],
            "properties": {
              "gather": {"type": "integer"}, "transform": {"type": "integer"}, "decide": {"type": "integer"},
              "create": {"type": "integer"}, "communicate": {"type": "integer"}, "coordinate": {"type": "integer"}
            }
          },
          "lenses": {
            "type": "object", "additionalProperties": false,
            "required": ["faster", "autonomous", "ambitious", "joy", "options", "altitude", "reach"],
            "properties": {
              "faster": {"type": "string"}, "autonomous": {"type": "string"}, "ambitious": {"type": "string"},
              "joy": {"type": "string"}, "options": {"type": "string"}, "altitude": {"type": "string"},
              "reach": {"type": "array", "items": {"type": "string"}}
            }
          },
          "human_edge": {"type": "string"},
          "pattern": {"type": "string", "enum": ["deterministic_software", "llm_step", "agent_with_gate", "copilot", "keep_human"]},
          "pattern_why": {"type": "string"},
          "autonomy_level": {"type": "integer", "minimum": 0, "maximum": 5},
          "in_practice": {
            "type": "object", "additionalProperties": false,
            "required": ["trigger", "steps", "human_gate", "systems", "data_needed", "logs_to"],
            "properties": {
              "trigger": {"type": "string"},
              "steps": {"type": "array", "items": {"type": "string"}},
              "human_gate": {"type": "string"},
              "systems": {"type": "array", "items": {"type": "string"}},
              "data_needed": {"type": "array", "items": {"type": "string"}},
              "logs_to": {"type": "string"}
            }
          },
          "time_saved_pct": {"type": "integer", "minimum": 0, "maximum": 100},
          "speedup": {"type": "number", "description": "How many times faster the remaining human part plus the automated part is than today, e.g. 1.5, 3, 10"},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim", "grade", "source"],
              "properties": {
                "claim": {"type": "string"},
                "grade": {"type": "string", "enum": ["E0", "E1", "E2", "E3"], "description": "E0 imagined, E1 plausible from model knowledge, E2 a named product does this today, E3 a documented case"},
                "source": {"type": "string", "description": "Product name, case, URL, or 'model knowledge'"}
              }
            }
          },
          "risks": {"type": "array", "items": {"type": "string"}},
          "research_questions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["altitude", "reach", "ceiling_note", "skills_to_grow", "ambitious_version"],
      "properties": {
        "altitude": {"type": "string", "description": "What this role becomes one layer of abstraction up"},
        "reach": {"type": "array", "items": {"type": "string"}, "description": "Tasks of adjacent roles, inside or outside the team, this role could absorb"},
        "ceiling_note": {"type": "string", "description": "What limits how far this role can go, in hours or kinds of work"},
        "skills_to_grow": {"type": "array", "items": {"type": "string"}},
        "ambitious_version": {"type": "string", "description": "What this role would do if it aimed much higher with AI"}
      }
    }
  }
}
